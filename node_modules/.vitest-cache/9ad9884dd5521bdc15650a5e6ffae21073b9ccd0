id f(int n,int k){if(n>=k)f(n/k,k);cout<<digit[n%k];}\\nint main(){f(0,2);}\",\n    \"role\": \"10..19는 A..J를 사용하는 출력 규칙입니다. 공백 없는 결과를 쓰세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"몫 n/k를 먼저 출력한 뒤 나머지 n%k를 출력한다.\",\n    \"execution\": \"n<k에서 한 자릿수를 출력한다. 0도 출력하고 10..19는 A..J 등 자릿수 기호로 대응한다.\",\n    \"caution\": \"낮은 자릿수부터 나오므로 역순이다. 재귀 호출을 먼저 수행한다.\",\n    \"questionId\": \"Q058\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-1\",\n        \"page\": 16\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"n>0일 때 자릿수 Θ(log_k n) 시간·스택, n=0은 O(1).\"\n  },\n  {\n    \"id\": \"pattern-reverse\",\n    \"conceptId\": \"reverse\",\n    \"name\": \"숫자 뒤집기\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint main(){int n=12300,r=0;do{r=10*r+n%10;n/=10;}while(n);cout<<r;}\",\n    \"role\": \"누적 방식의 역순 정수 출력을 쓰세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"일의 자리부터 출력하되 앞에 오는 0만 생략한다.\",\n    \"execution\": \"반복 누적값 r=10*r+n%10을 쓰면 유효 숫자만 남고 내부 0은 유지된다.\",\n    \"caution\": \"1002의 역순은 2001이다. 내부 0은 삭제하면 안 된다.\",\n    \"questionId\": \"Q061\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-2\",\n        \"page\": 3\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"자릿수 Θ(log_10 n) 시간, 반복 누적 O(1) 보조 공간.\"\n  },\n  {\n    \"id\": \"pattern-combination\",\n    \"conceptId\": \"combination\",\n    \"name\": \"조합의 점화식\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nlong long c(int n,int k){if(k==0||k==n)return 1;return c(n-1,k-1)+c(n-1,k);}\\nint main(){cout<<c(6,2);}\",\n    \"role\": \"마지막 물건의 선택 여부에 따른 재귀값을 구하세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"C(n,k)=C(n-1,k-1)+C(n-1,k).\",\n    \"execution\": \"마지막 물건을 고르거나 안 고르는 서로 겹치지 않는 두 경우로 나눈다. 수업은 k=1,n=k를 기초로 둔다.\",\n    \"caution\": \"마지막 물건의 선택 여부가 달라 서로 겹치지 않으며 전체를 덮는다.\",\n    \"questionId\": \"Q065\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-3\",\n        \"page\": 4\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"메모 없는 파스칼 재귀 최악 지수 시간(O(2^n) 상한), 깊이 O(n).\"\n  },\n  {\n    \"id\": \"pattern-tiling\",\n    \"conceptId\": \"tiling\",\n    \"name\": \"2×n 타일 채우기\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint main(){const int n=2,m=100009;vector<long long>d(n+2);d[0]=d[1]=1%m;for(int i=2;i<=n;i++)d[i]=(d[i-1]+2*d[i-2])%m;cout<<d[n];}\",\n    \"role\": \"회전 가능한 2×1, 2×2 타일입니다. 출력 나머지를 구하세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"T(0)=T(1)=1, T(n)=T(n-1)+2T(n-2).\",\n    \"execution\": \"세로 2×1 하나, 가로 2×1 두 개, 2×2 하나로 끝을 분류한다. 각 갱신마다 m으로 나눈다.\",\n    \"caution\": \"빈 판을 채우는 방법은 아무것도 놓지 않는 한 가지다. T(2)=3을 얻는다.\",\n    \"questionId\": \"Q068\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-3\",\n        \"page\": 9\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"O(n) 시간, 표 O(n) 공간. 두 이전 값으로 O(1) 보조 공간 압축 가능.\"\n  },\n  {\n    \"id\": \"pattern-node-distance\",\n    \"conceptId\": \"node-distance\",\n    \"name\": \"완전이진트리 노드 거리\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint main(){int a=9,b=14,d=0;while(a!=b){if(a>b)a/=2;else b/=2;d++;}cout<<d;}\",\n    \"role\": \"루트=1, 부모=floor(x/2)인 레벨 순서 번호입니다. 간선 수를 구하세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"a=b이면 0, 큰 번호를 /2로 올리며 거리를 센다.\",\n    \"execution\": \"루트 1, 부모 x/2인 번호 체계에서는 큰 번호를 계속 올려 공통 조상에서 만난다. 시간 O(log max(a,b)).\",\n    \"caution\": \"번호 규칙이 없으면 사용할 수 없다. 원본의 완전이진트리 정의 문장은 표준 정의보다 강하다.\",\n    \"questionId\": \"Q071\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 4\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"O(log max(a,b)) 시간, 반복 버전 O(1) 공간.\"\n  },\n  {\n    \"id\": \"pattern-encode\",\n    \"conceptId\": \"encode\",\n    \"name\": \"이진 암호\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nstring s=\\\"00111101\\\";\\nvoid f(int k,int n){bool same=true;for(int i=k;i<k+n;i++)if(s[i]!=s[k])same=false;if(same)cout<<s[k];else{cout<<\\\"-\\\";f(k,n/2);f(k+n/2,n/2);}}\\nint main(){f(0,s.size());}\",\n    \"role\": \"균일하면 한 문자, 섞였으면 -와 양쪽 암호를 출력합니다.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"균일하면 0/1, 섞였으면 - 뒤에 왼쪽·오른쪽 암호를 출력한다.\",\n    \"execution\": \"길이를 반씩 나누고 전위 순서로 출력한다. 00111101은 --01-1-01이다.\",\n    \"caution\": \"-는 내부 분할 노드 표시다. 없으면 복원 구조가 사라진다.\",\n    \"questionId\": \"Q073\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 10\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"구간 매번 전부 검사 시 최악 O(N log N), 호출 깊이 O(log N). 출력 공간 별도.\"\n  },\n  {\n    \"id\": \"pattern-decode\",\n    \"conceptId\": \"decode\",\n    \"name\": \"이진 복원\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nstring s=\\\"-1-01\\\",out(4,'?');int at=0;\\nvoid f(int k,int n){char v=s[at++];if(v=='-'){f(k,n/2);f(k+n/2,n/2);}else for(int i=k;i<k+n;i++)out[i]=v;}\\nint main(){f(0,4);cout<<out<<\\\" \\\"<<at;}\",\n    \"role\": \"길이 4, 암호 -1-01을 복원한 문자열과 소비한 토큰 수를 쓰세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"0/1이면 현재 영역을 채우고 -면 왼쪽·오른쪽을 재귀 복원한다.\",\n    \"execution\": \"입력 토큰 인덱스 하나를 모든 재귀 호출이 공유하며 호출될 때마다 하나씩 소비한다.\",\n    \"caution\": \"반환 위치를 전달하거나 참조/공유 인덱스를 사용해야 다음 토큰으로 진행한다.\",\n    \"questionId\": \"Q075\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 12\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"출력 길이 N, 토큰 수 L에 대해 O(N+L) 시간, O(log N) 호출 스택.\"\n  },\n  {\n    \"id\": \"pattern-partition-recur\",\n    \"conceptId\": \"partition-recur\",\n    \"name\": \"정수 분할의 두 갈래 점화식\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint p(int n,int k){if(n==0)return 1;if(k==0)return 0;return p(n,k-1)+(n>=k?p(n-k,k):0);}\\nint main(){cout<<p(5,5);}\",\n    \"role\": \"순서는 무시하고 각 항은 1..k 범위입니다.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"P(n,k)=P(n,k-1)+P(n-k,k), n>=k.\",\n    \"execution\": \"k를 안 쓰는 경우와 적어도 하나 쓰는 경우다. n<k이면 P(n,k-1), P(0,k)=1, P(n,0)=0(n>0).\",\n    \"caution\": \"k를 한 번 더 쓸 수 없게 되어 서로 다른 항의 분할을 세게 된다.\",\n    \"questionId\": \"Q076\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 6\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"이 예제는 메모 없는 재귀, 중복 상태로 지수 비용 가능. DP는 O(nk) 상태·시간.\"\n  },\n  {\n    \"id\": \"pattern-fibonacci\",\n    \"conceptId\": \"fibonacci\",\n    \"name\": \"피보나치와 중복 호출\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint cnt=0,dt[7];\\nint f(int n){cnt++;if(n<=2)return 1;return f(n-1)+f(n-2);}\\nint main(){cout<<f(6)<<\\\" \\\"<<cnt;}\",\n    \"role\": \"F(6)과 호출 횟수(캐시 적중 호출·기초 호출 포함)를 쓰세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"F(1)=F(2)=1, F(n)=F(n-1)+F(n-2).\",\n    \"execution\": \"단순 재귀는 중복 호출로 지수 시간, 메모/반복 DP는 O(n)이다. 수업은 mod 100009를 사용한다.\",\n    \"caution\": \"그 조건은 주어진 양의 입력에 대한 구현 축약이다. 입력 범위를 함께 봐야 한다.\",\n    \"questionId\": \"Q078\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 8\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"단순 재귀 지수 시간(O(2^n) 상한), 스택 O(n). 메모 사용 시 O(n) 시간·공간.\"\n  },\n  {\n    \"id\": \"pattern-ore\",\n    \"conceptId\": \"ore\",\n    \"name\": \"광석 수집\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint main(){vector<vector<int>>a={{1,0,1},{0,1,0},{1,1,1}};int d[4][4]={};for(int r=1;r<=3;r++)for(int c=1;c<=3;c++)d[r][c]=a[r-1][c-1]+max(d[r-1][c],d[r][c-1]);cout<<d[3][3];}\",\n    \"role\": \"시작칸을 포함합니다. 오른쪽·아래로만 이동하여 우하단까지 갑니다.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"D[r][c]=mine[r][c]+max(D[r-1][c],D[r][c-1]).\",\n    \"execution\": \"위·왼쪽에서 현재로 오는 최댓값을 합친다. 시작칸 포함, 첫 행·첫 열은 유일한 경로로 누적한다.\",\n    \"caution\": \"한 경로에서 모을 수 있는 최대 개수이다. 서로 다른 경로의 광석을 동시에 합칠 수 없다.\",\n    \"questionId\": \"Q080\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-6\",\n        \"page\": 6\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"n×m 표, O(nm) 시간·공간. 한 행으로 O(m) 공간 압축 가능.\"\n  },\n  {\n    \"id\": \"pattern-minimum-steps\",\n    \"conceptId\": \"minimum-steps\",\n    \"name\": \"숙직 선생님 최소 단계\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint main(){const int n=14,INF=100000;vector<int>d(n+1,INF),step={2,5,7};d[0]=0;for(int i=1;i<=n;i++)for(int s:step)if(i>=s)d[i]=min(d[i],d[i-s]+1);cout<<(d[n]>=INF?-1:d[n]);}\",\n    \"role\": \"현재 위치 1, 목표 위치 1+이동 거리입니다. 양의 세 이동 거리만 사용합니다. 도달 불가는 -1을 출력합니다.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"D[a]=0, D[x]=1+min D[x-d]로 최소 이동 횟수를 구한다.\",\n    \"execution\": \"양의 세 이동 거리만 사용하며 x 증가 순서로 채운다. 도달 불가는 INF, 최종 도달 불가면 -1이다.\",\n    \"caution\": \"0이 최선으로 선택되어 가짜 경로를 만든다. 도달 불가는 INF를 쓴다.\",\n    \"questionId\": \"Q082\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-6\",\n        \"page\": 4\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"거리 차이 d, 이동 종류 3개일 때 O(d) 시간·공간.\"\n  },\n  {\n    \"id\": \"pattern-paper\",\n    \"conceptId\": \"paper\",\n    \"name\": \"영역 구분의 4분할\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint a[2][2]={{0,1},{1,0}},w=0,g=0;\\nvoid f(int r,int c,int n){bool same=true;for(int i=r;i<r+n;i++)for(int j=c;j<c+n;j++)if(a[i][j]!=a[r][c])same=false;if(same){if(a[r][c])g++;else w++;return;}int h=n/2;f(r,c,h);f(r+h,c,h);f(r,c+h,h);f(r+h,c+h,h);}\\nint main(){f(0,0,2);cout<<w<<\\\" \\\"<<g;}\",\n    \"role\": \"흰색(0) 개수와 회색(1) 개수를 차례로 쓰세요. 균일한 정사각형은 더 나누지 않습니다.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"현재 정사각형이 한 색이면 세고, 아니면 4분할한다.\",\n    \"execution\": \"a,b,n 상태로 네 좌상단 좌표를 정한다. 원하는 색만 세면 다른 단색 영역은 0을 반환하고 멈춘다.\",\n    \"caution\": \"다른 색으로만 이루어진 영역은 기여도 0으로 종료해야 n=0 재귀를 막는다.\",\n    \"questionId\": \"Q144\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 7\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"매 구간 전체 검사하는 4분할은 최악 O(n² log n), 호출 깊이 O(log n).\"\n  },\n  {\n    \"id\": \"pattern-backtrack\",\n    \"conceptId\": \"backtrack\",\n    \"name\": \"선택·미선택 백트래킹\",\n    \"code\": \"#include <iostream>\\n#include <vector>\\n#include <algorithm>\\n#include <queue>\\n#include <stack>\\n#include <string>\\n#include <functional>\\n#include <utility>\\nusing namespace std;\\nint f(int i,int k){if(k==2)return 1;if(i==5)return 0;return f(i+1,k+1)+f(i+1,k);}\\nint main(){cout<<f(0,0);}\",\n    \"role\": \"f(i,k)는 i번째 물건을 결정하기 직전 k개 선택 상태입니다. N=5,K=2의 경우의 수를 구하세요.\\n출력의 정수·기호 순서를 공백으로 구분해 쓰세요. 배열 인덱스는 0부터입니다.\",\n    \"keyLine\": \"f(i,k)는 i번째 물건을 결정하기 직전 k개를 고른 상태.\",\n    \"execution\": \"k=K는 성공 1, i=N이면서 k!=K는 실패 0. 다음 상태는 f(i+1,k+1), f(i+1,k)다.\",\n    \"caution\": \"마지막 물건까지 골라 k=K가 된 성공을 놓친다. 성공 판정을 먼저 한다.\",\n    \"questionId\": \"Q148\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 14\n      }\n    ],\n    \"kind\": \"독립 실행 가능한 C++17 예제\",\n    \"complexity\": \"메모 없는 선택·미선택 최악 O(2^N), 깊이 O(N).\"\n  }\n]\n")
