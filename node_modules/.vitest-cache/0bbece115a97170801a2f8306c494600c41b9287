   ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"base-case\",\n    \"unitId\": \"relation-1\",\n    \"name\": \"재귀 종료 조건\",\n    \"english\": \"Base Case\",\n    \"summary\": \"직접 답을 아는 가장 작은 상태에서 재귀를 멈춘다.\",\n    \"detail\": \"모든 호출이 종료 조건으로 접근해야 한다. 입력 0 허용 여부에 따라 종료 조건도 바뀐다.\",\n    \"conditions\": \"매 호출에서 감소하는 비음수 척도 존재.\",\n    \"misconception\": \"종료 조건만 쓰면 무한 재귀가 사라진다.\",\n    \"correction\": \"상태가 줄지 않거나 종료 조건을 건너뛰면 여전히 끝나지 않는다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-1\",\n        \"page\": 10\n      }\n    ],\n    \"related\": [\n      \"induction\",\n      \"state\",\n      \"sum-linear\",\n      \"sum-half\"\n    ],\n    \"keywords\": [\n      \"재귀 종료 조건\",\n      \"Base Case\"\n    ],\n    \"hints\": [\n      \"chap1 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"매 호출에서 감소하는 비음수 척도 존재.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"sum-linear\",\n    \"unitId\": \"relation-1\",\n    \"name\": \"합의 선형 점화식\",\n    \"english\": \"Linear Sum Recurrence\",\n    \"summary\": \"S(1)=1, S(n)=S(n-1)+n.\",\n    \"detail\": \"재귀 깊이 Θ(n), 계산량 Θ(n). 반복문은 같은 계산을 O(1) 보조 공간으로 처리한다.\",\n    \"conditions\": \"n>=1, 충분한 정수 범위.\",\n    \"misconception\": \"long long 반환형이면 int 곱셈도 자동으로 안전하다.\",\n    \"correction\": \"곱셈 피연산자부터 넓은 형으로 바꾸어야 중간 오버플로를 막는다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-1\",\n        \"page\": 10\n      }\n    ],\n    \"related\": [\n      \"induction\",\n      \"state\",\n      \"base-case\",\n      \"sum-half\"\n    ],\n    \"keywords\": [\n      \"합의 선형 점화식\",\n      \"Linear Sum Recurrence\"\n    ],\n    \"hints\": [\n      \"chap1 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"n>=1, 충분한 정수 범위.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"sum-half\",\n    \"unitId\": \"relation-1\",\n    \"name\": \"합의 절반 점화식\",\n    \"english\": \"Halving Sum Recurrence\",\n    \"summary\": \"S(n)=2S(n/2)+((n+1)/2)², 정수 나눗셈.\",\n    \"detail\": \"S(n/2)를 한 번 계산하고 2를 곱하면 시간과 깊이 Θ(log n). 수업 기본값 S(1)=1.\",\n    \"conditions\": \"n>=1, 정수 나눗셈, 64비트 연산.\",\n    \"misconception\": \"재귀 호출이 2배니까 항상 O(n)이다.\",\n    \"correction\": \"2*f(n/2)는 호출 1회다. f(n/2)+f(n/2)는 호출 2회여서 다르다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-1\",\n        \"page\": 13\n      }\n    ],\n    \"related\": [\n      \"induction\",\n      \"state\",\n      \"base-case\",\n      \"sum-linear\"\n    ],\n    \"keywords\": [\n      \"합의 절반 점화식\",\n      \"Halving Sum Recurrence\"\n    ],\n    \"hints\": [\n      \"chap1 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"n>=1, 정수 나눗셈, 64비트 연산.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"base-conversion\",\n    \"unitId\": \"relation-1\",\n    \"name\": \"재귀 진법 변환\",\n    \"english\": \"Recursive Base Conversion\",\n    \"summary\": \"몫 n/k를 먼저 출력한 뒤 나머지 n%k를 출력한다.\",\n    \"detail\": \"n<k에서 한 자릿수를 출력한다. 0도 출력하고 10..19는 A..J 등 자릿수 기호로 대응한다.\",\n    \"conditions\": \"0<=n<=100000, 2<=k<=20. 앱은 0..9,A..J 사용.\",\n    \"misconception\": \"나머지를 먼저 출력하면 원래 순서이다.\",\n    \"correction\": \"낮은 자릿수부터 나오므로 역순이다. 재귀 호출을 먼저 수행한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-1\",\n        \"page\": 16\n      }\n    ],\n    \"related\": [\n      \"reverse\",\n      \"reverse-width\",\n      \"stars\"\n    ],\n    \"keywords\": [\n      \"재귀 진법 변환\",\n      \"Recursive Base Conversion\"\n    ],\n    \"hints\": [\n      \"chap1 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"0<=n<=100000, 2<=k<=20. 앱은 0..9,A..J 사용.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"reverse\",\n    \"unitId\": \"relation-2\",\n    \"name\": \"숫자 뒤집기\",\n    \"english\": \"Digit Reversal\",\n    \"summary\": \"일의 자리부터 출력하되 앞에 오는 0만 생략한다.\",\n    \"detail\": \"반복 누적값 r=10*r+n%10을 쓰면 유효 숫자만 남고 내부 0은 유지된다.\",\n    \"conditions\": \"수업 기본 1..50000. 0 확장은 별도 처리.\",\n    \"misconception\": \"모든 0을 생략하면 된다.\",\n    \"correction\": \"1002의 역순은 2001이다. 내부 0은 삭제하면 안 된다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-2\",\n        \"page\": 3\n      }\n    ],\n    \"related\": [\n      \"reverse-width\",\n      \"base-conversion\",\n      \"stars\"\n    ],\n    \"keywords\": [\n      \"숫자 뒤집기\",\n      \"Digit Reversal\"\n    ],\n    \"hints\": [\n      \"chap2 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"수업 기본 1..50000. 0 확장은 별도 처리.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"reverse-width\",\n    \"unitId\": \"relation-2\",\n    \"name\": \"숫자 뒤집기의 자리수 오류\",\n    \"english\": \"Width Loss in Recursion\",\n    \"summary\": \"양 끝을 제거한 내부 수는 원래 폭을 잃을 수 있다.\",\n    \"detail\": \"1010의 내부 01이 숫자 1이 되어 f(1)=1로 계산된다. 원래 자리 폭을 상태에 추가해야 한다.\",\n    \"conditions\": \"자료에 오류!로 제시된 전략 #3.\",\n    \"misconception\": \"내부 수의 자릿수만 알면 원래 폭을 복구한다.\",\n    \"correction\": \"선행 0은 숫자 값만으로 복구할 수 없다. 폭을 전달하거나 누적 방식으로 바꾼다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-2\",\n        \"page\": 5\n      }\n    ],\n    \"related\": [\n      \"reverse\",\n      \"base-conversion\",\n      \"stars\"\n    ],\n    \"keywords\": [\n      \"숫자 뒤집기의 자리수 오류\",\n      \"Width Loss in Recursion\"\n    ],\n    \"hints\": [\n      \"chap2 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"자료에 오류!로 제시된 전략 #3.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"stars\",\n    \"unitId\": \"relation-2\",\n    \"name\": \"별 삼각형과 출력 순서\",\n    \"english\": \"Recursive Star Triangle\",\n    \"summary\": \"먼저 n-1행을 출력한 뒤 n개의 별을 출력한다.\",\n    \"detail\": \"총 별 수 n(n+1)/2이므로 출력량 자체가 Θ(n²). 문자열로 줄 단위 출력해도 출력량은 같고 호출 오버헤드를 줄인다.\",\n    \"conditions\": \"1<=n<=10000; 응용 과제는 반복문 제한.\",\n    \"misconception\": \"한 번의 printf로 각 줄을 출력하면 O(n)이다.\",\n    \"correction\": \"출력되는 문자 수를 세면 Θ(n²)이다. 함수 호출 수와 출력량은 다르다.\",\n    \"importance\": \"Important\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-2\",\n        \"page\": 8\n      }\n    ],\n    \"related\": [\n      \"reverse\",\n      \"reverse-width\",\n      \"base-conversion\"\n    ],\n    \"keywords\": [\n      \"별 삼각형과 출력 순서\",\n      \"Recursive Star Triangle\"\n    ],\n    \"hints\": [\n      \"chap2 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"1<=n<=10000; 응용 과제는 반복문 제한.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"combination\",\n    \"unitId\": \"relation-3\",\n    \"name\": \"조합의 점화식\",\n    \"english\": \"Pascal Recurrence\",\n    \"summary\": \"C(n,k)=C(n-1,k-1)+C(n-1,k).\",\n    \"detail\": \"마지막 물건을 고르거나 안 고르는 서로 겹치지 않는 두 경우로 나눈다. 수업은 k=1,n=k를 기초로 둔다.\",\n    \"conditions\": \"1<=k<=n; 보충으로 C(n,0)=1, 범위 밖=0.\",\n    \"misconception\": \"두 항은 같은 경우를 중복해서 센다.\",\n    \"correction\": \"마지막 물건의 선택 여부가 달라 서로 겹치지 않으며 전체를 덮는다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-3\",\n        \"page\": 4\n      }\n    ],\n    \"related\": [\n      \"comb-overflow\",\n      \"comb-dp\",\n      \"backtrack\"\n    ],\n    \"keywords\": [\n      \"조합의 점화식\",\n      \"Pascal Recurrence\"\n    ],\n    \"hints\": [\n      \"chap3 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"1<=k<=n; 보충으로 C(n,0)=1, 범위 밖=0.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"comb-overflow\",\n    \"unitId\": \"relation-3\",\n    \"name\": \"조합의 중간값 오버플로\",\n    \"english\": \"Intermediate Overflow\",\n    \"summary\": \"최종 답이 들어가도 곱셈 중간값은 넘칠 수 있다.\",\n    \"detail\": \"곱셈을 나눗셈 앞에 두면 커지고, 정수 나눗셈을 먼저 하면 잘린다. 부동소수점은 오차가 있다.\",\n    \"conditions\": \"수업은 계산 순서·형 변환의 한계를 비교.\",\n    \"misconception\": \"double로 바꾸면 모든 조합을 정확하게 계산한다.\",\n    \"correction\": \"큰 정수는 double로 정확히 표현되지 않을 수 있다. 정수 DP나 약분·큰 정수 등을 조건에 맞게 사용한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-3\",\n        \"page\": 6\n      }\n    ],\n    \"related\": [\n      \"combination\",\n      \"comb-dp\",\n      \"backtrack\"\n    ],\n    \"keywords\": [\n      \"조합의 중간값 오버플로\",\n      \"Intermediate Overflow\"\n    ],\n    \"hints\": [\n      \"chap3 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"수업은 계산 순서·형 변환의 한계를 비교.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"tiling\",\n    \"unitId\": \"relation-3\",\n    \"name\": \"2×n 타일 채우기\",\n    \"english\": \"Tiling Recurrence\",\n    \"summary\": \"T(0)=T(1)=1, T(n)=T(n-1)+2T(n-2).\",\n    \"detail\": \"세로 2×1 하나, 가로 2×1 두 개, 2×2 하나로 끝을 분류한다. 각 갱신마다 m으로 나눈다.\",\n    \"conditions\": \"회전 가능한 2×1과 2×2 타일.\",\n    \"misconception\": \"T(0)=0이다.\",\n    \"correction\": \"빈 판을 채우는 방법은 아무것도 놓지 않는 한 가지다. T(2)=3을 얻는다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-3\",\n        \"page\": 9\n      }\n    ],\n    \"related\": [\n      \"tile-split\",\n      \"divide\"\n    ],\n    \"keywords\": [\n      \"2×n 타일 채우기\",\n      \"Tiling Recurrence\"\n    ],\n    \"hints\": [\n      \"chap3 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"회전 가능한 2×1과 2×2 타일.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"tile-split\",\n    \"unitId\": \"relation-3\",\n    \"name\": \"타일의 분할 관계식\",\n    \"english\": \"Divide Tiling\",\n    \"summary\": \"T(2q)=T(q)²+2T(q-1)².\",\n    \"detail\": \"홀수는 T(2q+1)=T(q)T(q+1)+2T(q-1)T(q). 기초 n=0,1,2를 먼저 처리해 음수 상태를 막는다.\",\n    \"conditions\": \"q>=1; 곱셈 전에 64비트 형과 모듈러 적용.\",\n    \"misconception\": \"같은 작은 상태를 매번 호출해도 자동으로 한 번만 계산한다.\",\n    \"correction\": \"수학 식만 바꿔도 중복 호출은 남을 수 있다. 지역 변수나 메모이제이션으로 재사용한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-3\",\n        \"page\": 10\n      }\n    ],\n    \"related\": [\n      \"tiling\",\n      \"divide\"\n    ],\n    \"keywords\": [\n      \"타일의 분할 관계식\",\n      \"Divide Tiling\"\n    ],\n    \"hints\": [\n      \"chap3 · 수학적 귀납법과 점화식에 속하는 개념입니다.\",\n      \"q>=1; 곱셈 전에 64비트 형과 모듈러 적용.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"divide\",\n    \"unitId\": \"relation-4\",\n    \"name\": \"분할 정복\",\n    \"english\": \"Divide and Conquer\",\n    \"summary\": \"같은 성질의 부분 문제로 나누고 답을 결합한다.\",\n    \"detail\": \"분할, 부분 문제 해결, 결합과 직접 해결 가능한 기초 상태를 정의한다.\",\n    \"conditions\": \"부분 문제 크기가 작아져야 한다.\",\n    \"misconception\": \"부분 문제를 나누기만 하면 정답이다.\",\n    \"correction\": \"부분 해를 원문제 해로 결합하는 정당성도 필요하다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 2\n      }\n    ],\n    \"related\": [\n      \"tiling\",\n      \"tile-split\"\n    ],\n    \"keywords\": [\n      \"분할 정복\",\n      \"Divide and Conquer\"\n    ],\n    \"hints\": [\n      \"chap4 · 분할 정복에 속하는 개념입니다.\",\n      \"부분 문제 크기가 작아져야 한다.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"node-distance\",\n    \"unitId\": \"relation-4\",\n    \"name\": \"완전이진트리 노드 거리\",\n    \"english\": \"Heap-indexed Tree Distance\",\n    \"summary\": \"a=b이면 0, 큰 번호를 /2로 올리며 거리를 센다.\",\n    \"detail\": \"루트 1, 부모 x/2인 번호 체계에서는 큰 번호를 계속 올려 공통 조상에서 만난다. 시간 O(log max(a,b)).\",\n    \"conditions\": \"레벨 순서 번호, 양의 정수, 부모=floor(x/2).\",\n    \"misconception\": \"임의의 트리 번호에도 x/2가 부모이다.\",\n    \"correction\": \"번호 규칙이 없으면 사용할 수 없다. 원본의 완전이진트리 정의 문장은 표준 정의보다 강하다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 4\n      }\n    ],\n    \"related\": [\n      \"tree\",\n      \"tree-terms\",\n      \"depth-height\"\n    ],\n    \"keywords\": [\n      \"완전이진트리 노드 거리\",\n      \"Heap-indexed Tree Distance\"\n    ],\n    \"hints\": [\n      \"chap4 · 분할 정복에 속하는 개념입니다.\",\n      \"레벨 순서 번호, 양의 정수, 부모=floor(x/2).\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"paper\",\n    \"unitId\": \"relation-4\",\n    \"name\": \"영역 구분의 4분할\",\n    \"english\": \"Quadtree-style Paper Division\",\n    \"summary\": \"현재 정사각형이 한 색이면 세고, 아니면 4분할한다.\",\n    \"detail\": \"a,b,n 상태로 네 좌상단 좌표를 정한다. 원하는 색만 세면 다른 단색 영역은 0을 반환하고 멈춘다.\",\n    \"conditions\": \"n은 2의 거듭제곱, 색 0/1.\",\n    \"misconception\": \"원하는 색이 아니면 계속 나눠야 한다.\",\n    \"correction\": \"다른 색으로만 이루어진 영역은 기여도 0으로 종료해야 n=0 재귀를 막는다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 7\n      }\n    ],\n    \"related\": [\n      \"encode\",\n      \"decode\"\n    ],\n    \"keywords\": [\n      \"영역 구분의 4분할\",\n      \"Quadtree-style Paper Division\"\n    ],\n    \"hints\": [\n      \"chap4 · 분할 정복에 속하는 개념입니다.\",\n      \"n은 2의 거듭제곱, 색 0/1.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"encode\",\n    \"unitId\": \"relation-4\",\n    \"name\": \"이진 암호\",\n    \"english\": \"Binary Run Divide Encoding\",\n    \"summary\": \"균일하면 0/1, 섞였으면 - 뒤에 왼쪽·오른쪽 암호를 출력한다.\",\n    \"detail\": \"길이를 반씩 나누고 전위 순서로 출력한다. 00111101은 --01-1-01이다.\",\n    \"conditions\": \"길이는 2의 거듭제곱, 알파벳 0/1.\",\n    \"misconception\": \"-는 단순 구분 문자여서 생략해도 된다.\",\n    \"correction\": \"-는 내부 분할 노드 표시다. 없으면 복원 구조가 사라진다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 10\n      }\n    ],\n    \"related\": [\n      \"paper\",\n      \"decode\"\n    ],\n    \"keywords\": [\n      \"이진 암호\",\n      \"Binary Run Divide Encoding\"\n    ],\n    \"hints\": [\n      \"chap4 · 분할 정복에 속하는 개념입니다.\",\n      \"길이는 2의 거듭제곱, 알파벳 0/1.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"decode\",\n    \"unitId\": \"relation-4\",\n    \"name\": \"이진 복원\",\n    \"english\": \"Recursive Decoding\",\n    \"summary\": \"0/1이면 현재 영역을 채우고 -면 왼쪽·오른쪽을 재귀 복원한다.\",\n    \"detail\": \"입력 토큰 인덱스 하나를 모든 재귀 호출이 공유하며 호출될 때마다 하나씩 소비한다.\",\n    \"conditions\": \"원본 길이와 유효한 암호 입력 제공.\",\n    \"misconception\": \"각 호출에 인덱스를 값으로 넘겨도 자동 진행된다.\",\n    \"correction\": \"반환 위치를 전달하거나 참조/공유 인덱스를 사용해야 다음 토큰으로 진행한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-4\",\n        \"page\": 12\n      }\n    ],\n    \"related\": [\n      \"paper\",\n      \"encode\"\n    ],\n    \"keywords\": [\n      \"이진 복원\",\n      \"Recursive Decoding\"\n    ],\n    \"hints\": [\n      \"chap4 · 분할 정복에 속하는 개념입니다.\",\n      \"원본 길이와 유효한 암호 입력 제공.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"partition\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"정수 분할의 상태\",\n    \"english\": \"Integer Partition State\",\n    \"summary\": \"P(n,k)는 k 이하 자연수의 합으로 n을 만드는 분할 수.\",\n    \"detail\": \"순서만 다른 합을 중복 계산하지 않는다. 열거 시 다음 수를 이전 수 이하로 제한한다.\",\n    \"conditions\": \"n>=0,k>=0, 양의 항만 허용.\",\n    \"misconception\": \"3+2와 2+3을 서로 다른 분할로 센다.\",\n    \"correction\": \"정수 분할은 순서를 무시한다. 수업 출력은 비증가 수열이다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 3\n      }\n    ],\n    \"related\": [\n      \"partition-recur\",\n      \"dynamic\"\n    ],\n    \"keywords\": [\n      \"정수 분할의 상태\",\n      \"Integer Partition State\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"n>=0,k>=0, 양의 항만 허용.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"partition-recur\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"정수 분할의 두 갈래 점화식\",\n    \"english\": \"Partition Recurrence\",\n    \"summary\": \"P(n,k)=P(n,k-1)+P(n-k,k), n>=k.\",\n    \"detail\": \"k를 안 쓰는 경우와 적어도 하나 쓰는 경우다. n<k이면 P(n,k-1), P(0,k)=1, P(n,0)=0(n>0).\",\n    \"conditions\": \"상태 범위에 따른 초기 조건 필수.\",\n    \"misconception\": \"P(n-k,k-1)로 바꾸어도 같다.\",\n    \"correction\": \"k를 한 번 더 쓸 수 없게 되어 서로 다른 항의 분할을 세게 된다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 6\n      }\n    ],\n    \"related\": [\n      \"partition\",\n      \"dynamic\"\n    ],\n    \"keywords\": [\n      \"정수 분할의 두 갈래 점화식\",\n      \"Partition Recurrence\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"상태 범위에 따른 초기 조건 필수.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"dynamic\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"동적표\",\n    \"english\": \"Dynamic Table\",\n    \"summary\": \"작은 상태의 값을 저장해 다른 상태 계산에 재사용한다.\",\n    \"detail\": \"중복 부분 문제의 반복 계산을 줄인다. 시간은 상태 수×상태당 전이 수로 분석한다.\",\n    \"conditions\": \"상태 정의와 의존 관계가 일관됨.\",\n    \"misconception\": \"표를 만들면 어떤 문제든 빨라진다.\",\n    \"correction\": \"숫자 뒤집기처럼 중복 호출이 없으면 저장 비용만 늘 수 있다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 7\n      }\n    ],\n    \"related\": [\n      \"partition\",\n      \"partition-recur\",\n      \"minimum-steps\",\n      \"ore\"\n    ],\n    \"keywords\": [\n      \"동적표\",\n      \"Dynamic Table\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"상태 정의와 의존 관계가 일관됨.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"memo\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"메모이제이션\",\n    \"english\": \"Memoization\",\n    \"summary\": \"한 번 계산한 상태의 답을 저장하고 재사용한다.\",\n    \"detail\": \"0이 유효한 결과면 DT[n]==0을 미계산 판정으로 쓰지 말고 seen 배열이나 별도 값을 둔다.\",\n    \"conditions\": \"같은 상태의 정답이 호출 경로와 독립.\",\n    \"misconception\": \"0으로 초기화하면 모든 문제의 캐시 판정이 해결된다.\",\n    \"correction\": \"모듈러 결과나 경우의 수가 0일 수 있으므로 미계산과 계산된 0을 구분한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 8\n      }\n    ],\n    \"related\": [\n      \"fibonacci\",\n      \"topdown\",\n      \"bottomup\",\n      \"dynamic-backtrack\"\n    ],\n    \"keywords\": [\n      \"메모이제이션\",\n      \"Memoization\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"같은 상태의 정답이 호출 경로와 독립.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"fibonacci\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"피보나치와 중복 호출\",\n    \"english\": \"Fibonacci\",\n    \"summary\": \"F(1)=F(2)=1, F(n)=F(n-1)+F(n-2).\",\n    \"detail\": \"단순 재귀는 중복 호출로 지수 시간, 메모/반복 DP는 O(n)이다. 수업은 mod 100009를 사용한다.\",\n    \"conditions\": \"수업 n>=1, 기초 1·2.\",\n    \"misconception\": \"자료의 n<=2를 모든 음수까지 수학 정의로 확장한다.\",\n    \"correction\": \"그 조건은 주어진 양의 입력에 대한 구현 축약이다. 입력 범위를 함께 봐야 한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 8\n      }\n    ],\n    \"related\": [\n      \"memo\",\n      \"topdown\",\n      \"bottomup\",\n      \"dynamic-backtrack\"\n    ],\n    \"keywords\": [\n      \"피보나치와 중복 호출\",\n      \"Fibonacci\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"수업 n>=1, 기초 1·2.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"topdown\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"하향식 설계\",\n    \"english\": \"Top-down Design\",\n    \"summary\": \"구하려는 큰 상태에서 필요한 작은 상태를 호출한다.\",\n    \"detail\": \"메모이제이션을 붙이면 도달하는 상태를 한 번씩 계산한다. 호출 스택 사용량도 고려한다.\",\n    \"conditions\": \"기초 상태로 가는 의존 관계.\",\n    \"misconception\": \"하향식은 반드시 메모이제이션을 쓴다.\",\n    \"correction\": \"하향식 재귀와 메모이제이션은 별개다. 수업은 적용 전후를 비교한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 10\n      }\n    ],\n    \"related\": [\n      \"memo\",\n      \"fibonacci\",\n      \"bottomup\",\n      \"dynamic-backtrack\"\n    ],\n    \"keywords\": [\n      \"하향식 설계\",\n      \"Top-down Design\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"기초 상태로 가는 의존 관계.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"bottomup\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"상향식 설계\",\n    \"english\": \"Bottom-up Design\",\n    \"summary\": \"의존하는 상태가 먼저 준비되도록 표를 채운다.\",\n    \"detail\": \"반복문을 쓴다는 사실보다 계산 의존 순서가 중요하다. 원본의 k+f(k+1) 예시는 반환 때 큰 k부터 합쳐진다.\",\n    \"conditions\": \"점화식에 맞는 순회 순서.\",\n    \"misconception\": \"매개변수 증가 방향만 보면 상향식 여부가 결정된다.\",\n    \"correction\": \"호출 진행 방향과 값의 실제 결합 순서를 구별해야 한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 11\n      }\n    ],\n    \"related\": [\n      \"memo\",\n      \"fibonacci\",\n      \"topdown\",\n      \"dynamic-backtrack\"\n    ],\n    \"keywords\": [\n      \"상향식 설계\",\n      \"Bottom-up Design\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"점화식에 맞는 순회 순서.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"comb-dp\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"조합 DP\",\n    \"english\": \"Combination DP\",\n    \"summary\": \"행 n은 이전 행 n-1의 두 값을 더해 채운다.\",\n    \"detail\": \"C[i][0]=C[i][i]=1로 두고 i 증가 순서로 계산한다. 공간 압축 시 j를 감소시켜 이전 행을 보존한다.\",\n    \"conditions\": \"경계와 자료형·mod 지정.\",\n    \"misconception\": \"1차원 DP의 j 순서는 상관없다.\",\n    \"correction\": \"j 증가 순서는 이번 행의 갱신값을 재사용해 다른 값을 만든다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 13\n      }\n    ],\n    \"related\": [\n      \"combination\",\n      \"comb-overflow\",\n      \"backtrack\"\n    ],\n    \"keywords\": [\n      \"조합 DP\",\n      \"Combination DP\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"경계와 자료형·mod 지정.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"backtrack\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"선택·미선택 백트래킹\",\n    \"english\": \"Choice Backtracking\",\n    \"summary\": \"f(i,k)는 i번째 물건을 결정하기 직전 k개를 고른 상태.\",\n    \"detail\": \"k=K는 성공 1, i=N이면서 k!=K는 실패 0. 다음 상태는 f(i+1,k+1), f(i+1,k)다.\",\n    \"conditions\": \"목표 N,K 고정, 순서 없는 선택 수 계산.\",\n    \"misconception\": \"i=N을 k=K보다 먼저 검사해 항상 0을 반환한다.\",\n    \"correction\": \"마지막 물건까지 골라 k=K가 된 성공을 놓친다. 성공 판정을 먼저 한다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 14\n      }\n    ],\n    \"related\": [\n      \"combination\",\n      \"comb-overflow\",\n      \"comb-dp\"\n    ],\n    \"keywords\": [\n      \"선택·미선택 백트래킹\",\n      \"Choice Backtracking\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"목표 N,K 고정, 순서 없는 선택 수 계산.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"dynamic-backtrack\",\n    \"unitId\": \"relation-5\",\n    \"name\": \"다이나미컬 백트래킹\",\n    \"english\": \"Memoized Backtracking\",\n    \"summary\": \"백트래킹 상태에 동적표를 붙여 중복 상태 계산을 줄인다.\",\n    \"detail\": \"수업의 용어는 메모이제이션을 붙인 상태 탐색을 가리킨다. 경로 누적값까지 답에 영향을 주면 상태에 포함하거나 반환 정의를 바꾼다.\",\n    \"conditions\": \"동일 상태의 미래 결과가 같음.\",\n    \"misconception\": \"어떤 누적값이든 i,k만 캐시하면 된다.\",\n    \"correction\": \"서로 다른 누적 조건에서 결과가 달라지면 상태 정보가 부족하다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-5\",\n        \"page\": 15\n      }\n    ],\n    \"related\": [\n      \"memo\",\n      \"fibonacci\",\n      \"topdown\",\n      \"bottomup\"\n    ],\n    \"keywords\": [\n      \"다이나미컬 백트래킹\",\n      \"Memoized Backtracking\"\n    ],\n    \"hints\": [\n      \"chap5 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"동일 상태의 미래 결과가 같음.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"minimum-steps\",\n    \"unitId\": \"relation-6\",\n    \"name\": \"숙직 선생님 최소 단계\",\n    \"english\": \"Minimum Steps\",\n    \"summary\": \"D[a]=0, D[x]=1+min D[x-d]로 최소 이동 횟수를 구한다.\",\n    \"detail\": \"양의 세 이동 거리만 사용하며 x 증가 순서로 채운다. 도달 불가는 INF, 최종 도달 불가면 -1이다.\",\n    \"conditions\": \"1<=a<=b<=1000, 거리 1..100. 앞으로만 이동.\",\n    \"misconception\": \"방문하지 않은 상태를 0으로 두고 min을 취한다.\",\n    \"correction\": \"0이 최선으로 선택되어 가짜 경로를 만든다. 도달 불가는 INF를 쓴다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-6\",\n        \"page\": 4\n      }\n    ],\n    \"related\": [\n      \"ore\",\n      \"dynamic\"\n    ],\n    \"keywords\": [\n      \"숙직 선생님 최소 단계\",\n      \"Minimum Steps\"\n    ],\n    \"hints\": [\n      \"chap6 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"1<=a<=b<=1000, 거리 1..100. 앞으로만 이동.\"\n    ],\n    \"basis\": \"lecture\"\n  },\n  {\n    \"id\": \"ore\",\n    \"unitId\": \"relation-6\",\n    \"name\": \"광석 수집\",\n    \"english\": \"Maximum Grid Path Sum\",\n    \"summary\": \"D[r][c]=mine[r][c]+max(D[r-1][c],D[r][c-1]).\",\n    \"detail\": \"위·왼쪽에서 현재로 오는 최댓값을 합친다. 시작칸 포함, 첫 행·첫 열은 유일한 경로로 누적한다.\",\n    \"conditions\": \"오른쪽·아래만 이동, 광석 0/1, (1,1)→(n,m).\",\n    \"misconception\": \"DFS로 연결된 모든 광석을 합하면 된다.\",\n    \"correction\": \"한 경로에서 모을 수 있는 최대 개수이다. 서로 다른 경로의 광석을 동시에 합칠 수 없다.\",\n    \"importance\": \"Essential\",\n    \"sources\": [\n      {\n        \"sourceId\": \"relation-6\",\n        \"page\": 6\n      }\n    ],\n    \"related\": [\n      \"minimum-steps\",\n      \"dynamic\"\n    ],\n    \"keywords\": [\n      \"광석 수집\",\n      \"Maximum Grid Path Sum\"\n    ],\n    \"hints\": [\n      \"chap6 · 동적표를 이용한 알고리즘 설계에 속하는 개념입니다.\",\n      \"오른쪽·아래만 이동, 광석 0/1, (1,1)→(n,m).\"\n    ],\n    \"basis\": \"lecture\"\n  }\n]\n")
